# Copie ce fichier en .env.local pour le développement, ou renseigne ces variables
# dans les réglages de TON projet Vercel. Ne mets jamais de valeur réelle ici.

# Clé API Claude (console.anthropic.com). Conseil : une clé dédiée avec une limite de dépense.
ANTHROPIC_API_KEY=

# Modèle utilisé pour la session quotidienne (claude-opus-5-5 par défaut, claude-sonnet-5-5 moins cher).
AINVEST_MODEL=claude-opus-5-5

# Mot de passe pour accéder à ton instance (l'URL Vercel est publique).
APP_PASSWORD=

# Secret de signature des cookies de session : 32 octets aléatoires en base64.
# Génère-le avec : openssl rand -base64 32
APP_SECRET=

# Clé de chiffrement des jetons Finary stockés : 32 octets aléatoires en base64.
# Génère-la avec : openssl rand -base64 32
ENCRYPTION_KEY=

# Secret que Vercel envoie à la tâche planifiée (Vercel le renseigne si tu l'ajoutes).
CRON_SECRET=

# URL publique de ton instance, sans slash final (ex. https://mon-ainvest.vercel.app).
APP_URL=

# Base Redis (Upstash, via l'intégration Vercel Marketplace). Les deux noms sont acceptés.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Facultatif : client OAuth pré-approuvé par Finary pour ton instance (voir README).
FINARY_CLIENT_ID=
