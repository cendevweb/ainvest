# Copie ce fichier en .env.local pour le développement, ou renseigne ces variables
# dans les réglages de TON projet Vercel. Ne mets jamais de valeur réelle ici.

# Clé API Claude (console.anthropic.com) pour le brief marché du matin.
# Conseil : une clé dédiée avec une limite de dépense.
ANTHROPIC_API_KEY=

# Mot de passe pour accéder à ton instance (l'URL Vercel est publique).
APP_PASSWORD=

# Secret de signature des cookies de session : 32 octets aléatoires en base64.
# Génère-le avec : openssl rand -base64 32
APP_SECRET=

# Secret que Vercel envoie à la tâche planifiée du brief (Vercel le renseigne si tu l'ajoutes).
CRON_SECRET=

# URL publique de ton instance, sans slash final (ex. https://mon-ainvest.vercel.app).
APP_URL=

# Base Redis (Upstash, via l'intégration Vercel Marketplace). Les deux noms sont acceptés.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Secret du connecteur MCP AInvest (au moins 24 caractères, sans / ni +).
INGEST_TOKEN=

# Facultatif : budget mensuel de la clé API en dollars (100 par défaut) et modèle du brief (Sonnet par défaut).
AINVEST_MONTHLY_BUDGET_USD=
AINVEST_BRIEF_MODEL=
